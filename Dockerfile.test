# Etapa de build + instalação de dependências com uv (prod + dev)
FROM clebernandi/fastapi-base:latest AS builder

WORKDIR /app

# Atualiza pip, instala uv
RUN pip install --upgrade pip setuptools wheel && \
    pip install uv

# Copia arquivos de dependências
COPY pyproject.toml settings.toml README.md ./

# Copia TODOS os diretórios e arquivos necessários
COPY app ./app
COPY tests ./tests
COPY seeds ./seeds
COPY alembic ./alembic
COPY alembic.ini ./
COPY typings ./typings

# Instala todas as dependências (prod + dev) e cria venv
RUN uv sync --dev

# Container final para testes
FROM python:3.13-slim AS test

WORKDIR /app

# Instala libs do sistema necessárias
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential libpq-dev libjpeg-dev zlib1g-dev libpng-dev \
    libfreetype6-dev libffi-dev libssl-dev curl bash \
    && rm -rf /var/lib/apt/lists/*

# Instala uv no container final
RUN pip install --upgrade pip && pip install uv

# Instala o Alemnbic
RUN pip install --upgrade pip setuptools wheel alembic

# Copia o projeto completo do builder (incluindo .venv e todos os diretórios)
COPY --from=builder /app /app

# wait-for-it para garantir que o DB esteja pronto
ADD https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh /wait-for-it.sh
RUN chmod +x /wait-for-it.sh

# Expõe porta caso necessário
EXPOSE 8000

# Comando default para rodar os testes usando uv
CMD ["/wait-for-it.sh", "db:5432", "--timeout=60", "--strict", "--", "uv", "run", "pytest", "--maxfail=1", "--disable-warnings", "-v"]
